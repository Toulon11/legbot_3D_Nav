<?xml version="1.0"?>
<package format="3">
  <name>legbot_exploration</name>
  <version>0.1.0</version>
  <description>Cumulative point cloud frontier exploration for the existing SCAN waypoint interface.</description>
  <maintainer email="biao876990970@hotmail.com">Robot-Nav</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>ament_cmake_python</build_depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>legbot_bringup</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
