      <link name="cylinder_16">
        <pose>-5 11.0 0.90 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.38</radius><length>1.80</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.38</radius><length>1.80</length></cylinder></geometry><material><diffuse>0.10 0.58 0.82 1</diffuse></material></visual>
