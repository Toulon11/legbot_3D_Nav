    <!-- Three segmented arch gates add overhead and side constraints while
         retaining about 2.1 m of clear width for the GO2. -->
    <model name="flat_arch_field">
      <static>true</static>
      <!-- Arch 1: x=-21, y=6. -->
      <link name="arch_01_left"><pose>-21 4.75 0.80 0 0 0</pose><collision name="collision"><geometry><box><size>0.40 0.38 1.60</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.40 0.38 1.60</size></box></geometry><material><diffuse>0.56 0.18 0.10 1</diffuse></material></visual></link>
      <link name="arch_01_right"><pose>-21 7.25 0.80 0 0 0</pose><collision name="collision"><geometry><box><size>0.40 0.38 1.60</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.40 0.38 1.60</size></box></geometry><material><diffuse>0.56 0.18 0.10 1</diffuse></material></visual></link>
