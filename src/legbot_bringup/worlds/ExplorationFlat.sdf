<?xml version="1.0"?>
<sdf version="1.9">
  <world name="tower">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.80 0.88 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- 32 x 32 m single-level exploration arena on the former flat western half.
         The robot retains the existing spawn point (-27, 6, 0.50). -->
    <model name="test_ground">
      <static>true</static>
      <pose>-16 0 0 0 0 0</pose>
      <link name="ground">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>32 32</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>32 32</size></plane></geometry>
          <material><ambient>0.48 0.52 0.48 1</ambient><diffuse>0.48 0.52 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Arena walls make the enlarged map boundary obvious and provide
         additional vertical returns for LiDAR localization. -->
    <model name="arena_boundaries">
      <static>true</static>
      <link name="north_wall">
        <pose>-16 16 0.60 0 0 0</pose>
        <collision name="collision"><geometry><box><size>32 0.20 1.20</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>32 0.20 1.20</size></box></geometry><material><diffuse>0.30 0.34 0.39 1</diffuse></material></visual>
      </link>
      <link name="south_wall">
        <pose>-16 -16 0.60 0 0 0</pose>
        <collision name="collision"><geometry><box><size>32 0.20 1.20</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>32 0.20 1.20</size></box></geometry><material><diffuse>0.30 0.34 0.39 1</diffuse></material></visual>
      </link>
      <link name="west_wall">
        <pose>-32 0 0.60 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.20 32 1.20</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.20 32 1.20</size></box></geometry><material><diffuse>0.30 0.34 0.39 1</diffuse></material></visual>
      </link>
      <link name="east_wall">
        <pose>0 0 0.60 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.20 32 1.20</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.20 32 1.20</size></box></geometry><material><diffuse>0.30 0.34 0.39 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Dense but traversable cylinder field in the flat western half.
         The staggered layout forces avoidance while preserving several
         routes, including a route near y=6 across the flat arena. -->
    <model name="flat_cylinder_field">
      <static>true</static>
      <link name="cylinder_01">
        <pose>-28 -9.5 0.70 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.45</radius><length>1.40</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.45</radius><length>1.40</length></cylinder></geometry><material><diffuse>0.90 0.28 0.12 1</diffuse></material></visual>
      </link>
      <link name="cylinder_02">
        <pose>-27 -2.8 1.00 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.34</radius><length>2.00</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.34</radius><length>2.00</length></cylinder></geometry><material><diffuse>0.95 0.68 0.10 1</diffuse></material></visual>
      </link>
      <link name="cylinder_03">
        <pose>-26 11.5 0.85 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.50</radius><length>1.70</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.50</radius><length>1.70</length></cylinder></geometry><material><diffuse>0.12 0.62 0.82 1</diffuse></material></visual>
