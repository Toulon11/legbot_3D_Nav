      <link name="arch_01_crown_4"><pose>-21 6.48 2.08 -0.30 0 0</pose><collision name="collision"><geometry><box><size>0.40 0.62 0.22</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.40 0.62 0.22</size></box></geometry><material><diffuse>0.72 0.26 0.12 1</diffuse></material></visual></link>
