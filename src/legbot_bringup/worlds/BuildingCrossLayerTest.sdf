<?xml version="1.0"?>
<sdf version="1.9">
  <world name="tower">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.80 0.88 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- The finite ground spans X=[-11,11] and Y=[-11,12]. Its top is Z=0. -->
    <model name="test_ground">
      <static>true</static>
      <pose>0 0.5 -0.10 0 0 0</pose>
      <link name="ground">
        <collision name="collision">
          <geometry><box><size>22 23 0.20</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>22 23 0.20</size></box></geometry>
          <material><diffuse>0.48 0.52 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="arena_boundaries">
      <static>true</static>
      <link name="north_wall">
        <pose>0 11.90 0.60 0 0 0</pose>
        <collision name="collision"><geometry><box><size>22 0.20 1.20</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>22 0.20 1.20</size></box></geometry><material><diffuse>0.30 0.34 0.39 1</diffuse></material></visual>
      </link>
      <link name="south_wall">
        <pose>0 -10.90 0.60 0 0 0</pose>
        <collision name="collision"><geometry><box><size>22 0.20 1.20</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>22 0.20 1.20</size></box></geometry><material><diffuse>0.30 0.34 0.39 1</diffuse></material></visual>
      </link>
      <link name="west_wall">
        <pose>-10.90 0.5 0.60 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.20 23 1.20</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.20 23 1.20</size></box></geometry><material><diffuse>0.30 0.34 0.39 1</diffuse></material></visual>
      </link>
      <link name="east_wall">
        <pose>10.90 0.5 0.60 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.20 23 1.20</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.20 23 1.20</size></box></geometry><material><diffuse>0.30 0.34 0.39 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Translate the complete building so its collision mesh fits the arena. -->
    <include>
      <uri>model://Building</uri>
      <name>multi_storey_stair_building</name>
      <pose>-1.45 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
